# ── Frontend (Vite) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Supabase Edge Function secrets ──────────────────────────
# These are NOT read by Vite. Set them on the project with:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# See docs/BILLING.md for the full setup.
#
# STRIPE_SECRET_KEY=sk_test_xxx           # stripe-checkout + stripe-webhook
# STRIPE_WEBHOOK_SECRET=whsec_xxx         # stripe-webhook only
# STRIPE_PRICE_CREW=price_xxx             # $29/mo recurring price (50 stages)
# STRIPE_PRICE_STUDIO=price_xxx           # $49/mo recurring price (100 stages)
# SITE_URL=https://paintstagepro.com      # Checkout success/cancel redirects
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
